rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/settings/app {
      allow read: if signedInAs(uid);
      allow write: if signedInAs(uid) && validAppSettings();
    }

    match /users/{uid}/gitProviderAccounts/{connectionID} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validGitProviderAccount();
    }

    match /users/{uid}/repositoryBookmarks/{bookmarkID} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validRepositoryBookmark();
    }

    match /users/{uid}/gitFlowConfigurations/{repositoryID} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validGitFlowConfiguration();
      allow delete: if false;
    }

    match /users/{uid}/deviceAccess/summary {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validDeviceAccessSummary(uid);
      allow delete: if false;
    }

    match /users/{uid}/devices/{deviceID} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && validDevice(deviceID);
      allow delete: if false;
    }

    function validAppSettings() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'appearance',
          'showToolbarButtonText',
          'showGitFlow',
          'showSubmodules',
          'showSubtrees',
          'showHeaderBranchButton',
          'showHeaderMergeButton',
          'showHeaderStashButton',
          'showHeaderUndoButton',
          'showHeaderRemoteButton',
          'showHeaderFinderButton',
          'showHeaderEditorButton',
          'showHeaderTerminalButton',
          'showHeaderSettingsButton',
          'historyBranchFilter',
          'historyIncludeRemotes',
          'autoFetchEnabled',
          'refreshOnAppActive',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'showToolbarButtonText',
          'showSubmodules',
          'showSubtrees',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 1
        && (!('appearance' in request.resource.data)
          || request.resource.data.appearance in ['system', 'light', 'dark'])
        && request.resource.data.showToolbarButtonText is bool
        && (!('showGitFlow' in request.resource.data) || request.resource.data.showGitFlow is bool)
        && request.resource.data.showSubmodules is bool
        && request.resource.data.showSubtrees is bool
        && (!('showHeaderBranchButton' in request.resource.data) || request.resource.data.showHeaderBranchButton is bool)
        && (!('showHeaderMergeButton' in request.resource.data) || request.resource.data.showHeaderMergeButton is bool)
        && (!('showHeaderStashButton' in request.resource.data) || request.resource.data.showHeaderStashButton is bool)
        && (!('showHeaderUndoButton' in request.resource.data) || request.resource.data.showHeaderUndoButton is bool)
        && (!('showHeaderRemoteButton' in request.resource.data) || request.resource.data.showHeaderRemoteButton is bool)
        && (!('showHeaderFinderButton' in request.resource.data) || request.resource.data.showHeaderFinderButton is bool)
        && (!('showHeaderEditorButton' in request.resource.data) || request.resource.data.showHeaderEditorButton is bool)
        && (!('showHeaderTerminalButton' in request.resource.data) || request.resource.data.showHeaderTerminalButton is bool)
        && (!('showHeaderSettingsButton' in request.resource.data) || request.resource.data.showHeaderSettingsButton is bool)
        && (!('historyBranchFilter' in request.resource.data)
          || (request.resource.data.historyBranchFilter is string
            && request.resource.data.historyBranchFilter.matches('^(all|current|branch:.+)$')))
        && (!('historyIncludeRemotes' in request.resource.data) || request.resource.data.historyIncludeRemotes is bool)
        && (!('autoFetchEnabled' in request.resource.data) || request.resource.data.autoFetchEnabled is bool)
        && (!('refreshOnAppActive' in request.resource.data) || request.resource.data.refreshOnAppActive is bool)
        && request.resource.data.updatedAt is timestamp;
    }

    function validGitProviderAccount() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'provider',
          'hostURL',
          'providerUserID',
          'username',
          'displayName',
          'avatarURL',
          'scopes',
          'permissions',
          'tokenStatus',
          'transportProtocol',
          'connectedAt',
          'lastValidatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'provider',
          'hostURL',
          'providerUserID',
          'username',
          'scopes',
          'permissions',
          'tokenStatus',
          'connectedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.provider in ['github', 'gitlab', 'bitbucket']
        && request.resource.data.hostURL is string
        && request.resource.data.providerUserID is string
        && request.resource.data.username is string
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('avatarURL' in request.resource.data) || request.resource.data.avatarURL is string)
        && request.resource.data.scopes is list
        && request.resource.data.permissions is map
        && (!('transportProtocol' in request.resource.data) || request.resource.data.transportProtocol in ['https', 'ssh'])
        && request.resource.data.tokenStatus in [
          'valid',
          'expired',
          'revoked',
          'reauthorizationRequired',
          'unavailableOnThisDevice'
        ]
        && request.resource.data.connectedAt is timestamp
        && (!('lastValidatedAt' in request.resource.data) || request.resource.data.lastValidatedAt is timestamp);
    }

    function validRepositoryBookmark() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'canonicalKey',
          'name',
          'provider',
          'host',
          'ownerPath',
          'remoteURL',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'canonicalKey',
          'name',
          'provider',
          'host',
          'ownerPath',
          'remoteURL',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.canonicalKey is string
        && request.resource.data.canonicalKey.size() > 0
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.provider in ['github', 'gitlab', 'bitbucket', 'generic']
        && request.resource.data.host is string
        && request.resource.data.host.size() > 0
        && request.resource.data.ownerPath is string
        && request.resource.data.ownerPath.size() > 0
        && request.resource.data.remoteURL is string
        && request.resource.data.remoteURL.matches('^https://.+')
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validGitFlowConfiguration() {
      return request.resource.data.keys().hasOnly([
          'schemaVersion',
          'canonicalKey',
          'isEnabled',
          'mainBranch',
          'developBranch',
          'featurePrefix',
          'bugfixPrefix',
          'releasePrefix',
          'hotfixPrefix',
          'topicFinishStrategy',
          'createReleaseTagOnFinish',
          'createHotfixTagOnFinish',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'schemaVersion',
          'canonicalKey',
          'isEnabled',
          'mainBranch',
          'developBranch',
          'featurePrefix',
          'bugfixPrefix',
          'releasePrefix',
          'hotfixPrefix',
          'topicFinishStrategy',
          'createReleaseTagOnFinish',
          'createHotfixTagOnFinish',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.canonicalKey is string
        && request.resource.data.canonicalKey.size() > 0
        && request.resource.data.canonicalKey.size() <= 1024
        && request.resource.data.isEnabled is bool
        && validGitFlowName(request.resource.data.mainBranch, false)
        && validGitFlowName(request.resource.data.developBranch, false)
        && validGitFlowName(request.resource.data.featurePrefix, true)
        && validGitFlowName(request.resource.data.bugfixPrefix, true)
        && validGitFlowName(request.resource.data.releasePrefix, true)
        && validGitFlowName(request.resource.data.hotfixPrefix, true)
        && request.resource.data.topicFinishStrategy in ['mergeNoFastForward', 'rebaseFastForward']
        && request.resource.data.createReleaseTagOnFinish is bool
        && request.resource.data.createHotfixTagOnFinish is bool
        && request.resource.data.updatedAt is timestamp;
    }

    function validGitFlowName(value, allowsEmpty) {
      return value is string
        && value.size() <= 255
        && (allowsEmpty || value.size() > 0);
    }

    match /entitlements/{uid} {
      allow read: if signedInAs(uid);
      allow write: if false;
    }

    match /featurePolicies/release {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function deviceLimit(uid) {
      let path = /databases/$(database)/documents/entitlements/$(uid);
      return exists(path)
        && get(path).data.plan == 'pro'
        && get(path).data.access == 'active'
        ? 3
        : 1;
    }

    function validDeviceAccessSummary(uid) {
      let ids = request.resource.data.activeDeviceIDs;
      return request.resource.data.keys().hasOnly(['schemaVersion', 'activeDeviceIDs', 'updatedAt'])
        && request.resource.data.schemaVersion == 1
        && ids is list
        && ids.size() <= deviceLimit(uid)
        && (ids.size() < 1 || ids[0] is string)
        && (ids.size() < 2 || ids[1] is string)
        && (ids.size() < 3 || ids[2] is string)
        && request.resource.data.updatedAt == request.time;
    }

    function validDevice(deviceID) {
      return request.resource.data.keys().hasOnly([
          'schemaVersion', 'deviceID', 'platform', 'modelFamily', 'osVersion',
          'appVersion', 'status', 'createdAt', 'lastSeenAt', 'revokedAt', 'revokedReason'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.deviceID == deviceID
        && request.resource.data.platform == 'macOS'
        && request.resource.data.modelFamily is string
        && request.resource.data.modelFamily.size() > 0
        && request.resource.data.modelFamily.size() <= 80
        && request.resource.data.osVersion is string
        && request.resource.data.osVersion.size() <= 40
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 40
        && request.resource.data.status in ['active', 'revoked']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastSeenAt is timestamp
        && (!('revokedAt' in request.resource.data) || request.resource.data.revokedAt is timestamp)
        && (!('revokedReason' in request.resource.data)
          || request.resource.data.revokedReason in ['signedOut', 'replaced', 'planDowngrade', 'userRevoked']);
    }
  }
}
